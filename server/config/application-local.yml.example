# Copy to server/config/application-local.yml, then replace the password and invite code locally.
# Activate using program argument: --spring.profiles.active=local
# This example targets a locally installed MySQL 5.1.42 on port 3306.
server:
  port: 8080
spring:
  datasource:
    url: "jdbc:mysql://127.0.0.1:3306/family_learning_uuid?useUnicode=true&characterEncoding=UTF-8&useSSL=false&useLegacyDatetimeCode=false&serverTimezone=UTC"
    username: family
    password: "CHANGE_ME_to_your_own_local_password"
app:
  role: all
  storage-path: "D:/code/ai-develop-team/repos/family-learning/server/data/uploads"
  invite-code: "CHANGE_ME_to_your_own_registration_invite"
  ai-key: ""
  ai-base-url: "https://dashscope.aliyuncs.com"
  vision-model: "qwen3-vl-plus"
  speech-model: "qwen3-tts-flash"
